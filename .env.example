# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Leave empty locally to use the embedded database in ./.data
DATABASE_URL=

# Random 32+ characters: openssl rand -base64 48
SESSION_SECRET=

# Public address of the CRM, e.g. https://crm.sezarsigorta.com (shown on the Entegrasyonlar page)
PUBLIC_URL=

# Shared secret the WordPress site sends in the x-sezar-secret header: openssl rand -hex 32
WEBSITE_INTAKE_SECRET=

# Meta Lead Ads (developers.facebook.com → your app)
META_APP_SECRET=
META_VERIFY_TOKEN=
# Long-lived Page access token with leads_retrieval + pages_manage_metadata + pages_show_list
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# AI (policy reading + profile analysis). Leave empty to turn AI features off.
# Documents and anonymised profiles are sent to Anthropic (outside Turkey): check KVKK consent first.
ANTHROPIC_API_KEY=

# File storage for uploaded documents (production). Create a PRIVATE bucket in Supabase Storage.
# Locally, files go to ./.data/files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=belgeler
